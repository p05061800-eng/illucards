# Скопируйте в .env.local и подставьте значения (`cp .env.example .env.local`).
# На проде секреты только в панели хостинга (Vercel / Render).

# --- Vercel (сайт) — НЕ задавать TELEGRAM_BOT_TOKEN (409 Conflict с polling на Render) ---

# HTTP API бота на Render
TELEGRAM_BOT_API_URL=https://illucards-telegram-bot.onrender.com

# Секрет синка с ботом (тот же на Render: TELEGRAM_SYNC_API_SECRET и/или ILLUCARDS_LOGIN_CODE_SYNC_SECRET)
TELEGRAM_SYNC_API_SECRET=
ILLUCARDS_LOGIN_CODE_SYNC_SECRET=

# Секрет для GET /api/order/{id} и POST /api/order/update (тот же на Render)
ILLUCARDS_ORDER_UPDATE_SECRET=

# Подпись cookie после Telegram Login Widget (не токен бота)
TELEGRAM_WIDGET_COOKIE_SECRET=

# GET /api/user-state с Authorization (бот тянет корзину/бонусы)
ILLUCARDS_USER_STATE_SYNC_SECRET=illucards-dev-user-state-sync

# --- Render (бот) — TELEGRAM_BOT_TOKEN только здесь ---
