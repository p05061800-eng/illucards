# Скопируйте в .env.local и подставьте значения (`cp .env.example .env.local`).
# На проде секреты только в панели хостинга (Vercel / Render).

# GET /api/user-state с заголовком Authorization (бот на Render тянет корзину/бонусы).
# Локально: можно оставить пустым — в NODE_ENV=development без куки отдаётся пустой state без 503.
# Для синка с ботом на localhost задайте ту же строку в .env.local и у бота.
ILLUCARDS_USER_STATE_SYNC_SECRET=illucards-dev-user-state-sync

# Токен бота (виджет входа, коды, уведомления). На Vercel — если нужны эти фичи.
# TELEGRAM_BOT_TOKEN=
